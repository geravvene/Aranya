datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameEn    String
  nameTh    String
  order     Int       @default(0)
  icon      String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id            String    @id @default(cuid())
  slug          String    @unique
  nameEn        String
  nameTh        String
  descriptionEn String?
  descriptionTh String?
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  pricePerUnit  Float
  unitType      String    @default("gram") // gram, piece, can, pre-roll
  isAvailable   Boolean   @default(true)
  stockGrams    Float?    @default(0.0)
  thcPercent    Float?    @default(0.0)
  cbdPercent    Float?    @default(0.0)
  imageUrl      String?
  cultivation   String?   // "Living Soil Organic", "Indoor Hydro", "Greenhouse"
  
  // Terpene Profile (0.0 to 5.0 scale)
  myrcene       Float?    @default(0.0)
  limonene      Float?    @default(0.0)
  caryophyllene Float?    @default(0.0)
  terpenesNote  String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model StaffSession {
  id        String   @id @default(cuid())
  staffPin  String   // Hashed PIN
  role      String   @default("counter_staff")
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ─── Weed Walker Legacy Data (imported from Silompos CRM) ───

model Member {
  id         String   @id @default(cuid())
  name       String
  channel    String?
  dob        String?
  phone      String?  @unique
  email      String?
  firstVisit DateTime?
  lastVisit  DateTime?
  points     Int      @default(0) // Walker Points balance
  tier       String   @default("bronze") // bronze | silver | gold | platinum
  notes      String?
  syncedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transactions Transaction[]
}

model Transaction {
  id            String   @id @default(cuid())
  txDate        DateTime
  memberId      String?
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberName    String   // denormalized: name at time of transaction
  receiptNumber String   @unique
  status        String?
  amount        Float    @default(0.0)
  pointsEarned  Int      @default(0)
  txType        String?
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
}
